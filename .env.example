# DialySense AI Environment Configuration

# Database Configuration (PostgreSQL with SQLite fallback)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=dialysense_db

# Direct Database URL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dialysense_db

# Backend Ports
API_PREFIX=/api
MODEL_PATH=ml/dialysis_risk_model.joblib
REPORTS_DIR=reports
